{
  "version": "1.0",
  "description": "Seed benchmark for deterministic PandaHub Python/Java static rules. Small demonstration set, not a statistically sufficient benchmark and not model-training data by itself.",
  "split_ratio": {
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "label_space": [
    "PY-SYNTAX",
    "PY-DIV-ZERO",
    "PY-INPUT-COMPARE",
    "PY-EVAL",
    "PY-EXEC",
    "PY-BARE-EXCEPT",
    "JAVA-BRACES",
    "JAVA-MISSING-SEMICOLON",
    "JAVA-RUNTIME-EXEC"
  ],
  "cases": [
    {
      "case_id": "py-tr-01-div-literal",
      "language": "python",
      "filename": "main.py",
      "source_code": "value = 8 / 0\nprint(value)\n",
      "expected_rule_ids": [
        "PY-DIV-ZERO"
      ],
      "split": "train"
    },
    {
      "case_id": "py-tr-02-div-assigned",
      "language": "python",
      "filename": "main.py",
      "source_code": "denominator = 0\nresult = 12 / denominator\n",
      "expected_rule_ids": [
        "PY-DIV-ZERO"
      ],
      "split": "train"
    },
    {
      "case_id": "py-tr-03-mod-zero",
      "language": "python",
      "filename": "main.py",
      "source_code": "remainder = 10 % 0\n",
      "expected_rule_ids": [
        "PY-DIV-ZERO"
      ],
      "split": "train"
    },
    {
      "case_id": "py-tr-04-eval",
      "language": "python",
      "filename": "main.py",
      "source_code": "expression = input()\nresult = eval(expression)\n",
      "expected_rule_ids": [
        "PY-EVAL"
      ],
      "split": "train"
    },
    {
      "case_id": "py-tr-05-exec",
      "language": "python",
      "filename": "main.py",
      "source_code": "code_text = input()\nexec(code_text)\n",
      "expected_rule_ids": [
        "PY-EXEC"
      ],
      "split": "train"
    },
    {
      "case_id": "py-tr-06-bare-except",
      "language": "python",
      "filename": "main.py",
      "source_code": "try:\n    risky_operation()\nexcept:\n    pass\n",
      "expected_rule_ids": [
        "PY-BARE-EXCEPT"
      ],
      "split": "train"
    },
    {
      "case_id": "py-tr-07-syntax",
      "language": "python",
      "filename": "main.py",
      "source_code": "if True\n    print('missing colon')\n",
